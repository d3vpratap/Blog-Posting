<% layout('layout/layout') -%>


    <section>
        <section class="bg-primary text-white text-center py-5">
            <div class="container">
                <h1>Welcome to My Blog</h1>
                <p class="lead">Sharing thoughts, stories, and experiences</p>
            </div>
        </section>
    
        <!-- Blog Posts Section -->
       
        <section class="container my-5">
            <div class="row">
                    <div class="col-md-4">
                        <% for(let blog of blogs) { %>
                            <a href="/blogs/<%= blog.id %>">
                        <div class="card mb-4">
                            <img src="<%= blog.img %>" class="card-img-top" alt="<%= blog.title %>">
                            <div class="card-body">
                                <h5 class="card-title"><%= blog.title %></h5>
                                <p class="card-text text-truncate"><%= blog.blog %></p>
                            </div>
                        </div>
                    </a>  
                    <% } %>
                    </div>
            </div>
        </section>
       
           
        <!-- Footer -->
        <section class="bg-dark text-white text-center py-3">
            <div class="container">
                <p>&copy; <%= new Date().getFullYear() %> My Blog. All rights reserved.</p>
            </div>
        </section>
    
    </section>
 

    